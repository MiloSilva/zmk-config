#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD0";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        td1: td1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD1";
            #binding-cells = <0>;
            bindings = <&kp PG_UP>, <&kp HOME>;
        };

        td2: td2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD2";
            #binding-cells = <0>;
            bindings = <&kp PG_DN>, <&kp END>;
        };

        mmv {
            acceleration-exponent = <1>;
            time-to-max-speed-ms = <900>;
            delay-ms = <0>;
        };

        msc {
            acceleration-exponent = <1>;
            time-to-max-speed-ms = <400>;
            delay-ms = <0>;
        };
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <30>;
    };

    combos {
        compatible = "zmk,combos";
        combo_fn {
            timeout-ms = <100>;
            key-positions = <38 39>;
            bindings = <&mo 3>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
// ╭─────────────┬──────┬──────┬──────────────────┬──────┬──────╮   ╭──────────────┬──────┬───────────┬───────┬──────────┬──────────╮
    &kp TAB        &kp Q  &kp W  &kp E              &kp R  &kp T      &kp Y          &kp U  &kp I       &kp O   &kp P      &kp BSPC
// ├─────────────┼──────┼──────┼──────────────────┼──────┼──────┤   ├──────────────┼──────┼───────────┼───────┼──────────┼──────────┤
    &kp LEFT_SHIFT &kp A  &kp S  &kp D              &kp F  &kp G      &kp H          &kp J  &kp K       &kp L   &kp SEMI   &kp SQT
// ├─────────────┼──────┼──────┼──────────────────┼──────┼──────┤   ├──────────────┼──────┼───────────┼───────┼──────────┼──────────┤
    &kp LCTRL      &kp Z  &kp X  &kp C              &kp V  &kp B      &kp N          &kp M  &kp COMMA   &kp DOT &kp FSLH   &kp ESC
// ╰─────────────┴──────┴──────┼──────────────────┼──────┼──────┤   ├──────────────┼──────┼───────────┼───────┴──────────┴──────────╯
                                &kp LEFT_COMMAND   &mo 1  &kp SPACE  &kp ENTER      &mo 2  &kp LALT
//                             ╰──────────────────┴──────┴──────╯   ╰──────────────┴──────┴───────────╯
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
// ╭─────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────╮   ╭──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────╮
    &kp TAB   &kp NUMBER_1   &kp NUMBER_2   &kp NUMBER_3   &kp NUMBER_4   &kp NUMBER_5       &kp NUMBER_6   &kp NUMBER_7   &kp NUMBER_8   &kp NUMBER_9   &kp NUMBER_0   &kp BSPC
// ├─────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤   ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────┤
    &kp F1    &kp F2         &kp F3         &kp F4         &kp F5         &kp F6             &kp F7         &kp F8         &kp F9         &kp F10        &kp F11        &kp F12
// ├─────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤   ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────┤
    &trans    &kp LEFT       &kp UP         &kp DOWN       &kp RIGHT      &td1               &td2           &trans         &trans         &trans         &trans         &trans
// ╰─────────┴──────────────┴──────────────┼──────────────┼──────────────┼──────────────┤   ├──────────────┼──────────────┼──────────────┼──────────────┴──────────────┴──────────╯
                                            &kp LEFT_GUI   &trans         &kp SPACE          &kp ENTER      &trans         &kp RALT
//                                         ╰──────────────┴──────────────┴──────────────╯   ╰──────────────┴──────────────┴──────────────╯
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
// ╭──────────┬──────────────────┬──────────┬──────────┬──────────────────┬──────────────╮   ╭───────────────┬──────────────────┬─────────┬──────────┬──────────────┬──────────╮
    &kp TAB    &kp EXCL           &kp AT     &kp HASH   &kp DLLR           &kp PRCNT          &kp CARET       &kp AMPS           &kp TILDE &kp LPAR   &kp RPAR       &kp BSPC
// ├──────────┼──────────────────┼──────────┼──────────┼──────────────────┼──────────────┤   ├───────────────┼──────────────────┼─────────┼──────────┼──────────────┼──────────┤
    &kp PIPE   &kp ASTERISK       &kp UNDER  &kp LBRC   &kp LBKT           &kp LPAR           &kp RPAR        &kp RBKT           &kp RBRC  &kp MINUS  &kp PLUS       &kp EQUAL
// ├──────────┼──────────────────┼──────────┼──────────┼──────────────────┼──────────────┤   ├───────────────┼──────────────────┼─────────┼──────────┼──────────────┼──────────┤
    &trans     &kp SQT            &kp EXCL   &kp COLON  &kp LT             &kp FSLH           &kp BSLH        &kp GT             &kp SEMI  &kp QMARK  &kp DQT        &kp TILDE
// ╰──────────┴──────────────────┴──────────┼──────────┼──────────────────┼──────────────┤   ├───────────────┼──────────────────┼─────────┼──────────┴──────────────┴──────────╯
                                             &trans     &kp LEFT_GUI       &kp SPACE          &kp RET         &trans             &kp RALT
//                                          ╰──────────┴──────────────────┴──────────────╯   ╰───────────────┴──────────────────┴─────────╯
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_3 {
            display-name = "Fn";
            bindings = <
// ╭────────┬──────────────┬─────────────────┬──────────────┬──────────────┬──────────────╮   ╭────────────┬────────────┬────────────┬────────────┬────────────┬────────────╮
    &trans   &trans         &kp PRINTSCREEN   &trans         &trans         &bt BT_SEL 0       &bt BT_CLR   &trans       &trans       &trans       &trans       &trans
// ├────────┼──────────────┼─────────────────┼──────────────┼──────────────┼──────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┼────────────┤
    &kp CLCK &bt BT_SEL 1   &bt BT_SEL 2     &bt BT_SEL 3   &bt BT_SEL 4   &trans             &mmv MOVE_UP &mmv MOVE_DOWN &mmv MOVE_LEFT &mmv MOVE_RIGHT &trans &trans
// ├────────┼──────────────┼─────────────────┼──────────────┼──────────────┼──────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┼────────────┤
    &trans   &trans         &trans            &trans         &trans         &trans             &trans       &mkp LCLK    &mkp RCLK    &trans       &trans       &trans
// ╰────────┴──────────────┴─────────────────┼──────────────┼──────────────┼──────────────┤   ├────────────┼────────────┼────────────┼────────────┴────────────┴────────────╯
                                              &kp C_MUTE    &trans         &trans             &trans       &trans       &trans
//                                           ╰──────────────┴──────────────┴──────────────╯   ╰────────────┴────────────┴────────────╯
            >;
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
